# Application Configuration
APP_NAME="GovtJob AI Agent"
APP_ENV="development"
DEBUG=true
LOG_LEVEL="INFO"
SECRET_KEY="development_secret_key_change_in_production_32bytes"

# Server Configuration
HOST="0.0.0.0"
PORT=8000
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Database Configuration
DATABASE_URL="sqlite:///./govtjob.db"

# Security & Encryption
ENCRYPTION_KEY="32_byte_secret_encryption_key_hash"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Provider Keys
OPENAI_API_KEY="sk-proj-your-openai-api-key-here"
OPENAI_MODEL="gpt-4o"

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN="1234567890:ABCdefGHIjklMNOpqrsTUVwxyz"
TELEGRAM_CHAT_ID="123456789"

# Browser Automator Settings
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_SLOW_MO=500
